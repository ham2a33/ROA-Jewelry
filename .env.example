# =============================================================================
# ROA Jewelry — environment variables
# Copy to `.env` for local development: cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# LOCAL DEVELOPMENT (npm run dev / npm run db:up)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/roa_jewelry?schema=public
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AUTH_SECRET=change-me-in-production-use-32-chars-min

# -----------------------------------------------------------------------------
# PRODUCTION (Dokploy runtime env — never commit real secrets)
# Domain (exact spelling): https://roa-jewerly.com
# Do NOT use roajewelry.com — that is a different hostname.
#
# DATABASE_URL=postgresql://postgres:postgres@roa-postgres:5432/roa_jewelry?schema=public
# NEXT_PUBLIC_SITE_URL=https://roa-jewerly.com
# AUTH_SECRET=<your-production-secret-min-32-chars>
#
# Dokploy UI:
#   - Container port: 3000 (internal — Traefik routes via dokploy-network)
#   - Domain: roa-jewerly.com (+ optional www.roa-jewerly.com)
#   - HTTPS: Let's Encrypt (automatic via Traefik labels in docker-compose.yml)
#
# Build-time (Docker build args / Dokploy build env):
#   NEXT_PUBLIC_SITE_URL=https://roa-jewerly.com
#   AUTH_SECRET=<min 32 chars placeholder for build only>
#
# First deploy on a fresh Dokploy host:
#   docker network create roa-jewelry-internal
#   docker volume create roa_jewelry_postgres_data
#   docker volume create roa_jewelry_uploads
# -----------------------------------------------------------------------------

# Media storage: local | cloudinary | s3
MEDIA_STORAGE_PROVIDER=local
MEDIA_UPLOAD_DIR=./public/uploads
MEDIA_PUBLIC_BASE_URL=

# Cloudinary — used when MEDIA_STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# S3-compatible storage — used when MEDIA_STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_HOSTNAME=
