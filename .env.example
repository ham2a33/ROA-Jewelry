# PostgreSQL
# Local dev: run `npm run db:up` to start Docker Postgres (see docker-compose.yml).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/roa_jewelry?schema=public"

# Public site URL used for canonicals, sitemap, Open Graph and robots
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth (admin sessions). Required in production when auth is implemented.
AUTH_SECRET=""

# Media storage: local | cloudinary | s3
MEDIA_STORAGE_PROVIDER="local"
MEDIA_UPLOAD_DIR="./public/uploads"
MEDIA_PUBLIC_BASE_URL=""

# Cloudinary — used when MEDIA_STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# S3-compatible storage — used when MEDIA_STORAGE_PROVIDER=s3
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_PUBLIC_HOSTNAME=""
