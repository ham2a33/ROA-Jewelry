# =============================================================================
# Production (Dokploy + Docker Compose + Traefik)
# =============================================================================
# Domain (exact spelling): https://roa-jewerly.com
# Do NOT use roajewelry.com — that is a different hostname and breaks Let's Encrypt.
#
# Dokploy UI:
#   - Container port: 3000 (NOT host port — Traefik uses internal network)
#   - Domain: roa-jewerly.com (+ optional www.roa-jewerly.com)
#   - HTTPS: Let's Encrypt (automatic)
#
# Build-time (Docker build args / Dokploy build env):
#   NEXT_PUBLIC_SITE_URL=https://roa-jewerly.com
#   AUTH_SECRET=<min 32 chars placeholder for build only>
#
# Runtime (Dokploy app env — never commit real secrets):
#   NODE_ENV=production
#   HOSTNAME=0.0.0.0
#   PORT=3000
#   DATABASE_URL=postgresql://postgres:postgres@postgres:5432/roa_jewelry?schema=public
#   AUTH_SECRET=<your-production-secret-min-32-chars>
#   MEDIA_STORAGE_PROVIDER=local
#   MEDIA_UPLOAD_DIR=./public/uploads
# =============================================================================

# PostgreSQL
# Local dev: run `npm run db:up`, publish 5432 via docker-compose.override.yml if needed.
# Production (compose internal network): hostname `postgres`.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/roa_jewelry?schema=public

# Public site URL — canonicals, sitemap, Open Graph, robots
# Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://roa-jewerly.com

# Admin sessions. Production requires at least 32 characters.
AUTH_SECRET=change-me-in-production-use-32-chars-min

# Media storage: local | cloudinary | s3
MEDIA_STORAGE_PROVIDER=local
MEDIA_UPLOAD_DIR=./public/uploads
MEDIA_PUBLIC_BASE_URL=

# Cloudinary — used when MEDIA_STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# S3-compatible storage — used when MEDIA_STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_HOSTNAME=
