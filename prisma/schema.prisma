generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
}

enum Gender {
  WOMEN
  MEN
  UNISEX
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum HomepageSectionType {
  HERO
  CATEGORIES
  BESTSELLERS
  NEW_ARRIVALS
  FEATURED
  PROMO
  BENEFITS
  ABOUT
  FINAL_CTA
  REVIEWS
  INSTAGRAM
  CUSTOM
}

enum StorageProvider {
  LOCAL
  CLOUDINARY
  S3
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         UserRole  @default(MANAGER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model Media {
  id           String          @id @default(cuid())
  url          String
  storageKey   String
  filename     String
  originalName String
  alt          String?
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  kind         MediaKind       @default(IMAGE)
  provider     StorageProvider @default(LOCAL)
  folder       String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  categories               Category[]            @relation("CategoryImage")
  productImages            ProductImage[]
  variantImages            ProductVariant[]      @relation("VariantImage")
  reviewImages             ReviewImage[]
  banners                  Banner[]              @relation("BannerImage")
  bannersMobile            Banner[]              @relation("BannerMobileImage")
  homepageSections         HomepageSection[]     @relation("SectionImage")
  homepageSectionsMobile   HomepageSection[]     @relation("SectionMobileImage")
  homepageSectionItems     HomepageSectionItem[] @relation("SectionItemMedia")
  siteSettingsLogo         SiteSettings[]        @relation("SiteLogo")
  siteSettingsFavicon      SiteSettings[]        @relation("SiteFavicon")
  siteSettingsOg           SiteSettings[]        @relation("SiteOgImage")

  @@index([provider])
  @@index([folder])
  @@index([kind])
  @@index([createdAt])
  @@map("media")
}

model Category {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String?
  imageId        String?
  image          Media?   @relation("CategoryImage", fields: [imageId], references: [id], onDelete: SetNull)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products      Product[]
  homepageItems HomepageSectionItem[]

  @@index([isActive, sortOrder])
  @@index([imageId])
  @@map("categories")
}

model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  description      String?  @db.Text
  shortDescription String?
  price            Decimal  @db.Decimal(12, 2)
  compareAtPrice   Decimal? @db.Decimal(12, 2)
  sku              String   @unique
  stock            Int      @default(0)
  material         String?
  hallmark         String?
  weightGrams      Decimal? @db.Decimal(10, 3)
  gender           Gender   @default(UNISEX)
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  isNew            Boolean  @default(false)
  isBestseller     Boolean  @default(false)
  isFeatured       Boolean  @default(false)
  isActive         Boolean  @default(true)
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  images        ProductImage[]
  variants      ProductVariant[]
  orderItems    OrderItem[]
  reviews       Review[]
  favorites     Favorite[]
  cartItems     CartItem[]
  homepageItems HomepageSectionItem[]

  @@index([categoryId])
  @@index([isActive])
  @@index([isActive, price])
  @@index([isNew, isActive])
  @@index([isBestseller, isActive])
  @@index([isFeatured, isActive])
  @@index([gender])
  @@index([createdAt])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  alt       String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, mediaId])
  @@index([productId, sortOrder])
  @@index([mediaId])
  @@map("product_images")
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  sku        String   @unique
  price      Decimal? @db.Decimal(12, 2)
  stock      Int      @default(0)
  imageId    String?
  image      Media?   @relation("VariantImage", fields: [imageId], references: [id], onDelete: SetNull)
  attributes Json?
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orderItems OrderItem[]
  cartItems  CartItem[]

  @@index([productId, isActive])
  @@index([imageId])
  @@map("product_variants")
}

model Customer {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  phone        String?
  passwordHash String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders    Order[]
  reviews   Review[]
  favorites Favorite[]
  cartItems CartItem[]

  @@index([phone])
  @@index([isActive])
  @@map("customers")
}

model Order {
  id                 String      @id @default(cuid())
  orderNumber        String      @unique
  customerId         String?
  customer           Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status             OrderStatus @default(PENDING)
  email              String
  phone              String
  customerName       String
  shippingCity       String?
  shippingAddress    String?
  shippingPostalCode String?
  shippingNotes      String?
  subtotal           Decimal     @db.Decimal(12, 2)
  shippingCost       Decimal     @db.Decimal(12, 2) @default(0)
  discount           Decimal     @db.Decimal(12, 2) @default(0)
  total              Decimal     @db.Decimal(12, 2)
  notes              String?     @db.Text
  adminNotes         String?     @db.Text
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  items OrderItem[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@map("orders")
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName String
  sku         String
  price       Decimal         @db.Decimal(12, 2)
  quantity    Int
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model Review {
  id          String    @id @default(cuid())
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  authorName  String
  rating      Int
  title       String?
  body        String    @db.Text
  isApproved  Boolean   @default(false)
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  images ReviewImage[]

  @@index([productId, isPublished])
  @@index([isApproved, isPublished])
  @@index([createdAt])
  @@index([customerId])
  @@map("reviews")
}

model ReviewImage {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([reviewId, mediaId])
  @@index([mediaId])
  @@map("review_images")
}

model Banner {
  id            String    @id @default(cuid())
  title         String?
  subtitle      String?
  imageId       String
  image         Media     @relation("BannerImage", fields: [imageId], references: [id], onDelete: Restrict)
  mobileImageId String?
  mobileImage   Media?    @relation("BannerMobileImage", fields: [mobileImageId], references: [id], onDelete: SetNull)
  buttonText    String?
  buttonUrl     String?
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isActive, sortOrder])
  @@index([imageId])
  @@index([mobileImageId])
  @@map("banners")
}

model HomepageSection {
  id            String              @id @default(cuid())
  type          HomepageSectionType
  key           String              @unique
  title         String?
  subtitle      String?
  description   String?             @db.Text
  buttonText    String?
  buttonUrl     String?
  imageId       String?
  image         Media?              @relation("SectionImage", fields: [imageId], references: [id], onDelete: SetNull)
  mobileImageId String?
  mobileImage   Media?              @relation("SectionMobileImage", fields: [mobileImageId], references: [id], onDelete: SetNull)
  isActive      Boolean             @default(true)
  sortOrder     Int                 @default(0)
  settings      Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  items HomepageSectionItem[]

  @@index([type, isActive, sortOrder])
  @@index([imageId])
  @@index([mobileImageId])
  @@map("homepage_sections")
}

model HomepageSectionItem {
  id          String          @id @default(cuid())
  sectionId   String
  section     HomepageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  categoryId  String?
  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  mediaId     String?
  media       Media?          @relation("SectionItemMedia", fields: [mediaId], references: [id], onDelete: SetNull)
  title       String?
  subtitle    String?
  description String?
  buttonText  String?
  buttonUrl   String?
  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([sectionId, sortOrder])
  @@index([productId])
  @@index([categoryId])
  @@index([mediaId])
  @@map("homepage_section_items")
}

model SiteSettings {
  id                    String   @id @default("default")
  siteName              String   @default("ROA Jewelry")
  tagline               String?
  logoId                String?
  logo                  Media?   @relation("SiteLogo", fields: [logoId], references: [id], onDelete: SetNull)
  faviconId             String?
  favicon               Media?   @relation("SiteFavicon", fields: [faviconId], references: [id], onDelete: SetNull)
  defaultOgImageId      String?
  defaultOgImage        Media?   @relation("SiteOgImage", fields: [defaultOgImageId], references: [id], onDelete: SetNull)
  contactEmail          String?
  contactPhone          String?
  address               String?
  instagramUrl          String?
  whatsappUrl           String?
  telegramUrl           String?
  defaultSeoTitle       String?
  defaultSeoDescription String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("site_settings")
}

model Favorite {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sessionId  String?
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@unique([customerId, productId])
  @@unique([sessionId, productId])
  @@index([productId])
  @@index([sessionId])
  @@map("favorites")
}

model CartItem {
  id         String          @id @default(cuid())
  customerId String?
  customer   Customer?       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sessionId  String?
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity   Int             @default(1)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([customerId])
  @@index([sessionId])
  @@index([productId])
  @@index([variantId])
  @@map("cart_items")
}
